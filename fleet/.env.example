# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (local stack: printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the app, used in login and invitation e-mails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
